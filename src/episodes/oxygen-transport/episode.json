    {
      "id": "co2-return",
      "template": "concept",
      "narration": "Most carbon dioxide doesn't ride back on hemoglobin. Inside red blood cells, an enzyme called ==carbonic anhydrase== converts it to **bicarbonate**, which travels in the plasma back to the lungs.",
      "params": {
        "term": "CO₂'s ride home",
        "definition": "Carbonic anhydrase in red blood cells turns CO₂ into bicarbonate for transport.",
        "bullets": [
          {
            "text": "Most: as bicarbonate (HCO₃⁻)",
            "at": "@bicarbonate"
          },
          {
            "text": "Some: bound to hemoglobin",
            "at": "@plasma"
          },
          {
            "text": "A little: dissolved in plasma",
            "at": "@lungs"
          }
        ],
        "formula": "CO₂ + H₂O ⇌ H₂CO₃ ⇌ H⁺ + HCO₃⁻"
      }
